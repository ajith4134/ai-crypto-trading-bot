@app.task(queue="default")
def update_pair_lists_from_decoder() -> dict:
    """R2 — refresh BRAIN_PAIR_PROBATION and BRAIN_PAIR_SUSPENSION from the
    decoder corpus. Probation: pair appears in F9 misses ≥3 times in last 24h.
    Suspension: pair appears as F12 loser ≥3 times in 24h (+5 strength delta),
    or ≥6 times in 24h (blocked=True for 6h).
    Graduates from probation: post-add closed_trades ≥ 50 AND winrate ≥ 50%.
    Auto-lifts suspension: now ≥ auto_lift_at."""
    import json as _json, sys, time
    if "/app" not in sys.path:
        sys.path.insert(0, "/app")
    import structlog
    from db import db_conn
    import redis_client
    import redis_keys
    log = structlog.get_logger()
    r = redis_client.get()

    # --- 1) F9 miss counts by pair (24h) → probation candidates ---
    with db_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                SELECT s.pair, COUNT(*) AS n
                FROM counterfactuals c
                JOIN signals s ON s.id = c.signal_id
                WHERE c.miss_decoded = TRUE
                  AND c.created_at > NOW() - INTERVAL '24 hours'
                GROUP BY s.pair
                HAVING COUNT(*) >= 3
            """)
            f9_pairs = dict(cur.fetchall())

            cur.execute("""
                SELECT t.pair, COUNT(*) AS n
                FROM mismatches m
                JOIN trades t ON t.id = m.loser_trade_id
                WHERE m.decoded_at > NOW() - INTERVAL '24 hours'
                GROUP BY t.pair
                HAVING COUNT(*) >= 3
            """)
            f12_loser_pairs = dict(cur.fetchall())

    now = int(time.time())

    # --- 2) Probation list build ---
    prob_raw = r.get(redis_keys.BRAIN_PAIR_PROBATION)
    probation = _json.loads(prob_raw) if prob_raw else {}
    if not isinstance(probation, dict):
        probation = {}

    for pair, miss_count in f9_pairs.items():
        if pair not in probation:
            probation[pair] = {
                "strength_delta":      -5.0,
                "candle_setup_boost":  0.05,
                "graduates_after":     50,
                "trades_in_probation": 0,
                "added_ts":            now,
                "miss_count_24h":      int(miss_count),
            }
        else:
            probation[pair]["miss_count_24h"] = int(miss_count)

    # Graduation check — pairs in probation whose post-add closed trades ≥ 50 AND WR ≥ 50%.
    if probation:
        with db_conn() as conn:
            with conn.cursor() as cur:
                graduated = []
                for pair, pd in list(probation.items()):
                    added_ts = pd.get("added_ts", now)
                    cur.execute("""
                        SELECT COUNT(*) AS n,
                               COUNT(*) FILTER (WHERE net_pnl_usdt > 0) AS wins
                        FROM trades
                        WHERE pair = %s
                          AND closed_at IS NOT NULL
                          AND opened_at > to_timestamp(%s)
                    """, (pair, added_ts))
                    n, wins = cur.fetchone()
                    n = int(n or 0); wins = int(wins or 0)
                    pd["trades_in_probation"] = n
                    pd["wins_in_probation"]   = wins
                    if n >= 50 and (wins / max(1, n)) >= 0.50:
                        graduated.append(pair)
                for pair in graduated:
                    del probation[pair]
                    log.info("pair_probation_graduated", pair=pair)

    try:
        r.set(redis_keys.BRAIN_PAIR_PROBATION, _json.dumps(probation))
        r.set("pair:probation:count", len(probation))
    except Exception:
        pass

    # --- 3) Suspension list build ---
    susp_raw = r.get(redis_keys.BRAIN_PAIR_SUSPENSION)
    suspension = _json.loads(susp_raw) if susp_raw else {}
    if not isinstance(suspension, dict):
        suspension = {}

    # Auto-lift expired suspensions.
    expired = [p for p, sd in suspension.items()
               if isinstance(sd, dict) and now >= int(sd.get("auto_lift_at", 0))]
    for pair in expired:
        del suspension[pair]
        log.info("pair_suspension_auto_lifted", pair=pair)

    # Add/update suspensions.
    for pair, loser_count in f12_loser_pairs.items():
        loser_count = int(loser_count)
        blocked = loser_count >= 6
        delta = 10.0 if blocked else 5.0
        suspension[pair] = {
            "strength_delta":  delta,
            "blocked":         blocked,
            "loser_count_24h": loser_count,
            "auto_lift_at":    now + (6 * 3600),
            "added_ts":        now,
        }

    try:
        r.set(redis_keys.BRAIN_PAIR_SUSPENSION, _json.dumps(suspension))
        r.set("pair:suspension:count", len(suspension))
    except Exception:
        pass

    log.info("pair_lists_updated",
             probation_count=len(probation),
             suspension_count=len(suspension),
             f9_pairs=len(f9_pairs),
             f12_loser_pairs=len(f12_loser_pairs))
    return {"status": "ok",
            "probation_count": len(probation),
            "suspension_count": len(suspension)}


@app.task(queue="default")
def compute_bot_confidence() -> dict:
    """R4 — recompute the bot self-confidence index."""
    import sys
    if "/app" not in sys.path:
        sys.path.insert(0, "/app")
    from metacognition.confidence import compute_and_store
    return compute_and_store(window_seconds=3600)


================================================================================
DEPLOY STEPS (after approval, in order):
================================================================================

1. Copy SQL draft → migrations/026_predicted_profit_loop_phase1.sql
2. Apply: `docker exec trading-bot-postgres-1 psql -U botuser -d trading_bot -f /migrations/026_*.sql`
3. Apply file patches 1-7 above (decoders, actuator, NEW confidence.py, redis_keys, engine, manager, celery_app).
4. Register F46 sub-gates in feature_governance/bootstrap.py: F46_bucketed, F46_pair_lists, F46_confidence (all gated on F46 parent).
5. Rebuild Docker image:
     `cd /opt/trading-bot && docker compose build && docker compose up -d`
6. Verify within 10 min:
   - `SELECT miss_tag, COUNT(*) FROM counterfactuals WHERE miss_decoded=TRUE
      AND created_at > NOW() - INTERVAL '1 hour' GROUP BY miss_tag;` → tags landing
   - `redis-cli GET brain:filter_overrides | jq` → v2 bucketed schema
   - `redis-cli GET brain:bot_confidence` → float in [0.20, 1.00]
   - `redis-cli GET brain:pair_probation | jq` → dict of probation pairs
7. Counters to watch (silent-rejection rule):
   - `decoders:f9_miss_tag_invalid_count` (should stay low)
   - `decoders:bucket_applied_count:bull|40-44` (should grow)
   - `bot:confidence:hard_skip_count` (should be rare; if >>0 the bot is in a slump)
   - `pair:suspension:blocked_count:*` (per-pair blocks)

ROLLBACK:
- File patches: revert via git or restore from /opt/trading-bot/backups/.
- Migration: run the rollback block at bottom of step1_026_*.sql.draft.
- Redis state can be wiped via `metacognition/actuator.py:reset_overrides()` for R1
  and `redis-cli DEL brain:pair_probation brain:pair_suspension brain:bot_confidence` for R2/R4.

