services:

  postgres:
    image: pgvector/pgvector:pg16
    restart: unless-stopped
    environment:
      POSTGRES_DB: trading_bot
      POSTGRES_USER: botuser
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - bot_net
    # NOT exposed externally — localhost only via Docker network

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    command: redis-server --maxmemory 1gb --maxmemory-policy allkeys-lru --save ""
    networks:
      - bot_net
    # NOT exposed externally

  ollama:
    image: ollama/ollama:latest
    restart: unless-stopped
    environment:
      # Unload models after 5 min idle so llama.cpp background tasks get full RAM
      OLLAMA_KEEP_ALIVE: "5m"
      # cont. 65k — RAM cap. Without these Ollama held 3 models resident at once
      # (mistral:7b + phi3:mini + nomic-embed = 8.8 GB) on a 19 GB box, leaving
      # ~400 MB free and starving CandleNet training + the evolution worker.
      # MAX_LOADED_MODELS=2 keeps at most one gen model + the small embedder
      # resident (~5.3 GB); every feature still requests its own model, Ollama
      # just evicts LRU instead of hoarding. Background LLM jobs run
      # sequentially so the working set is ≤2 → no swap thrash. NUM_PARALLEL=1
      # shrinks per-model KV cache (fine for async jobs). No hard mem_limit — a
      # cgroup ceiling would OOM-kill mid-inference (worse than capping load).
      OLLAMA_MAX_LOADED_MODELS: "2"
      OLLAMA_NUM_PARALLEL: "1"
    volumes:
      - ollama_models:/root/.ollama
    networks:
      - bot_net
    # Port 11434 NOT exposed externally — brain accesses via Docker network

  # llama_cpp service removed 2026-05-20.
  # History: blueprint specified AirLLM Llama 3.1 70B for background tasks
  # → AirLLM conversion needs ~132 GB RAM (loads all shards), OOM-killed
  # → switched to llama.cpp serving the 42.5 GB Q4_K_M GGUF
  # → on 16 GB / 4-core host the model never finished loading (1007 restarts,
  #   each restart re-ran the multi-minute CPU tensor repack from block 0)
  # Replacement: 3-provider cloud failover (Groq → Cerebras → SambaNova) all
  # hosting Llama 3.3 70B on OpenAI-compatible APIs. Same blueprint task set,
  # same 70B parameter class, fail-soft across providers. See
  # llm/researcher.py and BLUEPRINT_COMPLIANCE_AUDIT.md for the deviation
  # record (cloud-hosted vs blueprint's "all local" intent).

  brain:
    build: .
    restart: unless-stopped
    command: python main.py
    env_file: .env
    volumes:
      - /models:/models
      - /opt/trading-bot/models:/app/models
      # cont. 65k — deploy the PCG missing-forecast→OFI-fallback fix
      # (signals/engine.py) WITHOUT an image rebuild (disk ~90% full). The
      # brain runs process_signals → generate_candidate_signals, so the engine
      # change must be live here. Revert to baked image once disk is healthy.
      - ./signals:/app/signals
    depends_on:
      - postgres
      - redis
      - ollama
    networks:
      - bot_net
    deploy:
      resources:
        limits:
          memory: 2G

  data_feed:
    build: .
    restart: unless-stopped
    command: python -m data.feed
    env_file: .env
    volumes:
      # data_feed runs ml/gnn, ml/patchtst, ml/transfer_entropy, ml/mutual_info inference
      # on a schedule. Without this mount it reads stale .pth files baked into the image
      # at build time, not the current pretrained checkpoints. Rule 4 finding 2026-05-18.
      - /opt/trading-bot/models:/app/models
    depends_on:
      - redis
      - postgres
    networks:
      - bot_net
    deploy:
      resources:
        limits:
          memory: 1G

  scanner:
    build: .
    restart: unless-stopped
    command: python -m scanner.main
    env_file: .env
    depends_on:
      - redis
      - postgres
    networks:
      - bot_net
    deploy:
      resources:
        limits:
          memory: 512M

  web_intel:
    build: .
    restart: unless-stopped
    command: python -m web_intel.collector
    env_file: .env
    depends_on:
      - redis
      - postgres
    networks:
      - bot_net
    deploy:
      resources:
        limits:
          memory: 512M

  dashboard:
    build: .
    restart: unless-stopped
    command: uvicorn dashboard.api:app --host 0.0.0.0 --port 8000
    env_file: .env
    # cont. 52f — dashboard reads /app/models/* for its /models endpoint to
    # decide each model's status (active / stale / missing). Without this
    # mount the dashboard sees only the .pth files baked into the image at
    # build time, so CandleNet 1m/5m/15m (trained AFTER the last dashboard
    # build) show "missing" forever even though they exist on the host and
    # are loaded fine by brain/data_feed/celery_worker. Mirrors the same
    # mount used by every other service that touches /app/models.
    volumes:
      - /opt/trading-bot/models:/app/models
    depends_on:
      - redis
      - postgres
    networks:
      - bot_net
    # Dashboard not exposed directly to internet — nginx proxies to it
    deploy:
      resources:
        limits:
          memory: 512M

  celery_worker:
    build: .
    restart: unless-stopped
    # Worker consumes both queues. task_routes in celery_app.py was supposed to
    # collapse all "queue=airllm" tasks (opro_optimize, research_strategy,
    # generate_hypothesis, etc.) onto "default" but in practice the decorator
    # queue wins and tasks pile up in airllm. Consuming both queues is the
    # simplest correct fix; one worker handles everything.
    # Concurrency=2 — matches Ollama's effective single-threaded server-side
    # throughput. Bumping to 4 caused 3rd/4th workers to hit the 300s HTTP
    # read timeout while waiting in Ollama's queue.
    #
    # Queue split (cont. 40 follow-up): web_intel interpret_and_store calls
    # take ~120-300s each and were filling the default queue. Routed them
    # to a dedicated `web_intel` queue so fast tasks (DGM, research, retrain)
    # land in default and aren't blocked. Worker consumes default first,
    # then airllm/celery, then web_intel as the lowest-priority drain.
    command: celery -A celery_app worker --queues=default,airllm,celery,web_intel --concurrency=3 --loglevel=info
    env_file: .env
    # HF model cache — CryptoBERT (~440MB) + FinBERT (~440MB) + tokenizer
    # overhead persist on host so container rebuilds don't re-download.
    # See ml/sentiment.py — celery_worker is the inference host (background only).
    environment:
      - HF_HOME=/app/.hf_cache
      - TRANSFORMERS_CACHE=/app/.hf_cache
    volumes:
      - /opt/trading-bot/models:/app/models
      - ./hf_cache:/app/.hf_cache
      # cont. 65k — deploy the CLOUD-PRIMARY llm/researcher.py WITHOUT an image
      # rebuild (disk 90% full). The image still ships the old local-primary
      # researcher.py, which made interpret_and_store/web-intel tasks spend ~280s
      # on Ollama, jamming all worker slots and starving the OFI producer on the
      # `default` queue → stale OFI → no signals → no trades. Cloud-primary drops
      # those tasks to ~3s when cloud is available. celery_app.py mounted too so
      # the cont. 65k `llm`-queue routing is consistent once the dedicated llm
      # worker lands (follow-up; needs a rebuild window to deploy routing to all
      # enqueuers). Revert to baked image once disk is healthy.
      - ./llm:/app/llm
      - ./celery_app.py:/app/celery_app.py
    depends_on:
      - redis
      - postgres
      - ollama
    networks:
      - bot_net
    deploy:
      resources:
        limits:
          # 2G was tight once both BERT models loaded (~1.2G resident + tokenizer
          # overhead + the existing workload). Bumped to 3G to leave headroom.
          memory: 3G

  # cont. 65 — dedicated CandleNet worker. Isolates candlenet_infer_all (and
  # the four retrain_candlenet_{1m,5m,15m,1h} tasks) from the default queue
  # where they previously sat behind 15k+ LLM tasks, executing only every
  # ~38 min and letting {pair}:{tf}:candle_forecast keys (TTL 90s) expire
  # ~96% of the time. With this worker, candle-forecast keys stay warm and
  # downstream consumers (multi_tf_cascade, scanner F50a, engine F48 bonus,
  # predict_all xgb predictor) actually see live values.
  # Concurrency=1: CandleNet inference for 100 pairs × 4 TFs takes ~25-30s,
  # well under the 60s beat cadence. Concurrency=1 keeps memory + CPU
  # predictable; weekly retrains (Sunday 06:00-07:30 UTC) serialize on the
  # same worker which is intentional (each retrain is heavy by itself).
  celery_worker_candlenet:
    build: .
    restart: unless-stopped
    command: celery -A celery_app worker --queues=candlenet,predict_all --concurrency=2 --loglevel=info
    env_file: .env
    volumes:
      - /opt/trading-bot/models:/app/models
      # cont. 65f — mount historical CSVs so retrain_candlenet_30m / _1h can
      # read what pretrainer downloaded. Without this, the worker sees only
      # the image-baked snapshot (frozen at build time, no 30m.csv) and
      # retrain returns insufficient_data, pairs_loaded=0.
      - ./data/historical:/app/data/historical
      # cont. 65k — bind-mount the ml/ source so the class-balanced + true-ECE
      # CandleNet training fix (ml/candlenet.py) is live WITHOUT an image
      # rebuild. The host disk was 96% full and the build cache was pruned, so
      # a cold torch rebuild risked ENOSPC. This mount deploys the fix via a
      # plain recreate; revert to a baked image once disk is healthy.
      - ./ml:/app/ml
      # cont. 65k — routing consistency: manual retrains triggered from this
      # container must also route to cn_train (not the old candlenet queue).
      - ./celery_app.py:/app/celery_app.py
    depends_on:
      - redis
      - postgres
    networks:
      - bot_net
    deploy:
      resources:
        limits:
          # 7G holds the six CandleNet models (~4MB each) + torch runtime +
          # 1h training peak (~5.3GB GAF precompute on 92.7K samples) +
          # headroom. Bumped 1500→3000→7000 across cont. 65f as 30m/1h
          # retrain failures uncovered the real peak. Host has ~11G free
          # after pretrainer completed.
          memory: 7000M

  # cont. 65k — DEDICATED CandleNet TRAINING worker. Consumes the `cn_train`
  # queue (retrain_candlenet_{1m,5m,15m,30m,1h}) so the minutes-long, memory-heavy
  # retrains NEVER contend with candlenet_infer_all on celery_worker_candlenet.
  # Root cause it fixes: retrains on the shared `candlenet` queue starved
  # inference → forecasts expired (300s TTL) → PCG strict-rejected every signal →
  # trade freeze. Concurrency=1 (one heavy retrain at a time). Bind-mounts mirror
  # the candlenet worker (models + historical CSVs + live ml/ + routing).
  celery_worker_cn_train:
    # cont. 65k — reuse the candlenet worker's already-built image (NO build:
    # the host disk is ~90% full and the build cache was pruned). Same code +
    # the bind-mounts below deploy the live ml/ + celery_app.py changes.
    image: trading-bot-celery_worker_candlenet:latest
    restart: unless-stopped
    command: celery -A celery_app worker --queues=cn_train --concurrency=1 --loglevel=info
    env_file: .env
    volumes:
      - /opt/trading-bot/models:/app/models
      - ./data/historical:/app/data/historical
      - ./ml:/app/ml
      - ./celery_app.py:/app/celery_app.py
    depends_on:
      - redis
      - postgres
    networks:
      - bot_net
    deploy:
      resources:
        limits:
          # Training peak with clean triple-barrier data is ~250MB GAF cache +
          # torch runtime; 4G leaves ample headroom and frees RAM vs the old 7G.
          memory: 4000M

  # celery_beat scheduler — added 2026-05-20.
  # Without this, every crontab-scheduled task in celery_app.py (sleep_consolidation,
  # F25 GA, F39B DGM, F39C AI Scientist, F41 self_play, F30 governance check, F43
  # metacog, F2 pattern mining, F9 counterfactual sweep, web_intel outcome tracking,
  # daily/weekly summaries — 12 tasks total) never fired. Worker alone only EXECUTES
  # tasks; beat SCHEDULES them. Exactly one beat instance must exist to avoid
  # duplicate fires.
  celery_beat:
    build: .
    restart: unless-stopped
    command: celery -A celery_app beat --loglevel=info --schedule=/tmp/celerybeat-schedule
    env_file: .env
    volumes:
      # cont. 65k — beat must see the updated task_routes (retrain_candlenet_* →
      # cn_train queue) so SCHEDULED retrains reach the dedicated training worker.
      - ./celery_app.py:/app/celery_app.py
    depends_on:
      - redis
      - postgres
    networks:
      - bot_net
    deploy:
      resources:
        limits:
          memory: 256M

  watchdog:
    build: .
    restart: unless-stopped
    command: python -m watchdog.main
    env_file: .env
    # Host docker socket is root:docker (gid 1001 on this host). Add the
    # container user to that gid so docker SDK calls aren't PermissionError.
    group_add:
      - "1001"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      # cont. 47 — watchdog rewrites .env when the dashboard /bot/mode_switch
      # endpoint signals a paper↔live transition.
      - ./.env:/app/.env:rw
      # cont. 61 — retrain watchdog reads model file mtimes to detect stale
      # checkpoints and refire missed cron retrains. Without this mount,
      # watchdog reads stale baked-in files from the image and fires false
      # alarms.
      - /opt/trading-bot/models:/app/models:ro
    depends_on:
      - brain
      - data_feed
      - scanner
      - web_intel
      - dashboard
      - celery_worker
    networks:
      - bot_net
    deploy:
      resources:
        limits:
          memory: 256M

  pretrainer:
    build: .
    # One-shot service — not started by default `docker compose up`
    profiles:
      - pretrainer
    command: python -m pretrainer.main
    # cont. 65f — run as root so the container can write into the
    # bind-mounted host dir /opt/trading-bot/data/historical (owned by
    # ajithd747:ajithd747 0755). botuser (default) lacks write perms,
    # which crashed the 30m+50-new-pair CSV downloads with PermissionError.
    user: "0:0"
    env_file: .env
    volumes:
      # WRITES the pretrained .pth files here. Without this mount, training is
      # ephemeral and lost on container removal. Rule 4 finding 2026-05-18.
      - /opt/trading-bot/models:/app/models
      # Historical OHLCV CSVs persist across pretrainer runs (saves re-download)
      - ./data/historical:/app/data/historical
    depends_on:
      - postgres
    networks:
      - bot_net
    deploy:
      resources:
        limits:
          memory: 8G

  nginx:
    image: nginx:alpine
    restart: unless-stopped
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./frontend/build:/app/frontend/build:ro
    depends_on:
      - dashboard
    networks:
      - bot_net

volumes:
  postgres_data:
  ollama_models:

networks:
  bot_net:
    driver: bridge
