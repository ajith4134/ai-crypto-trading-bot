# Binance API credentials — create at https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Set to true for testnet, false for live trading
BINANCE_TESTNET=true

# Trading mode: paper or live
TRADING_MODE=paper

# Brain evolution — do not change manually; managed by the Brain
BRAIN_STAGE=1
# Minimum paper trades before live trading is unlocked
PAPER_TRADE_THRESHOLD=2000

# Maximum active trading pairs
MAX_ACTIVE_PAIRS=60

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL connection string
DB_CONNECTION_STRING=

# Telegram bot for alerts — create at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SerpAPI for web search — https://serpapi.com
SERPAPI_KEY=

# Reddit API — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Etherscan API — https://etherscan.io/apis
ETHERSCAN_API_KEY=

# CoinGecko API — https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# GitHub token for trending repo scraper — https://github.com/settings/tokens
GITHUB_TOKEN=
